# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server-only. Needed from Phase 6 (account export / delete). Never expose to the browser.
SUPABASE_SECRET_KEY=

# Weekly review email (Phase 8). Without these the cron endpoint refuses to run.
CRON_SECRET=
RESEND_API_KEY=
WEEKLY_REVIEW_FROM="JLIKA Gym <hello@yourdomain.com>"

# Web push (rest-timer alerts, workout-day reminders). Generate the pair once with
# `npx web-push generate-vapid-keys`; changing them later invalidates every device's
# subscription. Sending also needs SUPABASE_SECRET_KEY. Leave blank to switch push off.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@yourdomain.com

# Supabase Management API token, used only by scripts/apply-migrations.mjs
SUPABASE_ACCESS_TOKEN=

# AI Coach (optional). Without a key the AI Coach nav item and page do not exist.
ANTHROPIC_API_KEY=
# Model the AI Coach calls. Defaults to claude-opus-5-5.
AI_COACH_MODEL=
# Model runs (plan, refine or review) each account may start in any 24 hours. Defaults to 10.
AI_COACH_DAILY_LIMIT=
# Development only: 1 runs the AI Coach on canned answers, with no key and no requests. Ignored in production.
AI_COACH_FIXTURE=

# Operator dashboard (/admin). Comma-separated, case-insensitive emails of the accounts that
# may open it; each must be the account's verified email. Unset or empty = nobody, and /admin
# is a 404. It shows account-level facts and counts only — never anyone's training data.
# Needs SUPABASE_SECRET_KEY. Invite-only signup is switched on from the dashboard itself.
ADMIN_EMAILS=
