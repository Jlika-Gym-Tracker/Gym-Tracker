# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server-only. Needed from Phase 6 (account export / delete). Never expose to the browser.
SUPABASE_SECRET_KEY=

# Weekly review email (Phase 8). Without these the cron endpoint refuses to run.
CRON_SECRET=
RESEND_API_KEY=
WEEKLY_REVIEW_FROM="JLIKA Gym <hello@yourdomain.com>"

# Supabase Management API token, used only by scripts/apply-migrations.mjs
SUPABASE_ACCESS_TOKEN=

# AI Coach (optional). Without a key the AI Coach nav item and page do not exist.
ANTHROPIC_API_KEY=
# Model the AI Coach calls. Defaults to claude-opus-5-5.
AI_COACH_MODEL=
# Model runs (plan, refine or review) each account may start in any 24 hours. Defaults to 10.
AI_COACH_DAILY_LIMIT=
# Development only: 1 runs the AI Coach on canned answers, with no key and no requests. Ignored in production.
AI_COACH_FIXTURE=
